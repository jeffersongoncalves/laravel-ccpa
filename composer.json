{
    "name": "jeffersongoncalves/laravel-ccpa",
    "description": "CCPA/CPRA toolkit core for Laravel: declare personal information on Eloquent models with its §1798.140(v) category, sensitive flag and whether it is sold or shared; build the inventory, export, deidentify, check k-anonymity.",
    "keywords": [
        "laravel",
        "ccpa",
        "cpra",
        "privacy",
        "personal-information",
        "california",
        "deidentification"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-ccpa",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Simão Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\Ccpa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\Ccpa\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\Ccpa\\CcpaServiceProvider"
            ],
            "aliases": {
                "Ccpa": "JeffersonGoncalves\\Ccpa\\Facades\\Ccpa"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
